classDiagram
    %% Interface e Pagamento
    class FormaPagamento {
        <<interface>>
        +processarPagamento(valor: double): boolean
    }
    
    class Cartao {
        +processarPagamento(valor: double): boolean
    }
    class Cheque {
        +processarPagamento(valor: double): boolean
    }
    class Dinheiro {
        +processarPagamento(valor: double): boolean
    }
    FormaPagamento <|.. Cartao
    FormaPagamento <|.. Cheque
    FormaPagamento <|.. Dinheiro

    %% Itens do Cardápio (Superclasse e Subclasses)
    class ItemCardapio {
        <<abstract>>
        -nome: String
        -preco: double
        -diaDisponivel: String
        +ItemCardapio(nome: String, preco: double, diaDisponivel: String)
        +VerificarDisponibilidade(diaAtual: String): boolean
    }
    class Prato {
        -pontoCarne: String
    }
    class Bebida {
        -comGelo: boolean
    }
    ItemCardapio <|-- Prato
    ItemCardapio <|-- Bebida

    %% Hierarquia de Funcionários (Classe Abstrata)
    class Funcionario {
        <<abstract>>
        -id: int
        -nome: String
        +Funcionario(id: int, nome: String)
    }
    
    class Garcom {
        -exclusivoBebida: boolean
        +Garcom(id: int, nome: String, exclusivoBebida: boolean)
        +isExclusivoBebida(): boolean
    }
    
    class Telefonista {
        +Telefonista(id: int, nome: String)
    }
    
    class Entregador {
        -rotaAtual: String
        -disponivel: boolean
        +realizarEntrega(pedidos: List~Pedido~): void
    }
    
    class Gerente {
        +emitirOrdem(funcionario: Funcionario, ordem: String): void
    }
    
    class Manobrista {
        +buscarAutomovel(cliente: Cliente): void
    }
    
    Funcionario <|-- Garcom
    Funcionario <|-- Telefonista
    Funcionario <|-- Entregador
    Funcionario <|-- Gerente
    Funcionario <|-- Manobrista

    %% Estrutura Física e Localização
    class Endereco {
        -rua: String
        -numero: int
        -bairro: String
        +Endereco(rua: String, numero: int, bairro: String)
        +getEnderecoCompleto(): String
    }

    class Mesa {
        -numero: int
        -ocupada: boolean
        -horaChegada: LocalDateTime
        +Mesa(numero: int)
        +ocupar(chegada: LocalDateTime): void
        +liberar(): void
        +isOcupada(): boolean
    }

    class Regiao {
        -nome: String
        -mesas: List~Mesa~
        -garcons: List~Garcom~
        +Regiao(nome: String)
        +adicionarMesa(mesa: Mesa): void
        +adicionarGarcom(garcom: Garcom): void
    }

    %% Classes Pedidos e fechamento
    class Cliente {
        -id: int
        -nome: String
        -endereco: Endereco
        +Cliente(id: int, nome: String)
        +Cliente(id: int, nome: String, endereco: Endereco)
    }

    class ItemPedido {
        -item: ItemCardapio
        -devolvido: boolean
        -motivoDevolucao: String
        +ItemPedido(item: ItemCardapio)
        +registrarDevolucao(motivo: String): void
    }

    class Pedido {
        -id: int
        -cliente: Cliente
        -atendente: Funcionario
        -itens: List~ItemPedido~
        -mesa: Mesa
        -enderecoEntrega: Endereco
        -horaPedido: LocalDateTime
        -horaEntrega: LocalDateTime
        -dataHoraAgendada: LocalDateTime
        -pago: boolean
        +Pedido(id: int, cliente: Cliente, atendente: Funcionario)
        +adicionarItem(item: ItemCardapio): void
        +registrarEntrega(horaEntrega: LocalDateTime): void
        +calcularTempoAtendimento(): long
        +calcularTotal(): double
        +exibirResumo(): void
        +isPago(): boolean
        +setPago(pago: boolean): void
    }

    class Nota {
        -pedidos: List~Pedido~
        -cliente: Cliente
        -valorTotal: double
        -tempoAtendimento: double
        -tempoPermanencia: long
        +Nota(cliente: Cliente, pedidos: List~Pedido~)
        +calcularTotal(): double
        +calcularTempoMedioAtendimento(): double
        +calcularTempoPermanencia(): long
        +emitirNota(pagamento: FormaPagamento, gerente: Gerente, manobrista: Manobrista): void
    }

    %% Relacionamentos 
    Cliente "1" --> "0..1" Endereco : possui
    Cliente "1" -- "1..*" Pedido : faz >
    Pedido "*" -- "1" Funcionario : atende >
    Pedido "1" o-- "*" ItemCardapio : agrega >
    Pedido "*" --> "0..1" Endereco : entrega em
    Pedido "1" *-- "1..*" ItemPedido : compõe
    ItemPedido "*" --> "1" ItemCardapio : referencia

    Regiao "1" o-- "1..*" Mesa : agrupa
    Regiao "1" o-- "1..*" Garcom : aloca

    Entregador ..> Pedido : entrega
    Gerente ..> Funcionario : ordena
    Gerente ..> Manobrista : aciona
    Manobrista ..> Cliente : busca carro de

    Nota "1" -- "1..*" Pedido : consolida
    Nota "*" --> "1" Cliente : emitida para
    Nota ..> FormaPagamento : depende
    Nota ..> Gerente : notifica
    Nota ..> Manobrista : repassa
